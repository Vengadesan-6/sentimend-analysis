{
  "outputDirectory": "frontend/dist",
  "rewrites": [
    {
      "source": "/api",
      "destination": "https://sentimend-analysis.onrender.com/api"
    },
    {
      "source": "/api/:path*",
      "destination": "https://sentimend-analysis.onrender.com/api/:path*"
    },
    {
      "source": "/health",
      "destination": "https://sentimend-analysis.onrender.com/health"
    },
    {
      "source": "/docs",
      "destination": "https://sentimend-analysis.onrender.com/docs"
    },
    {
      "source": "/openapi.json",
      "destination": "https://sentimend-analysis.onrender.com/openapi.json"
    },
    {
      "source": "/((?!api|health|docs|openapi.json).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Access-Control-Allow-Credentials", "value": "true" },
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "Access-Control-Allow-Methods", "value": "GET,OPTIONS,PATCH,DELETE,POST,PUT" },
        { "key": "Access-Control-Allow-Headers", "value": "X-CSRF-Token, X-Requested-With, Accept, Accept-Version, Content-Length, Content-MD5, Content-Type, Date, X-Api-Version, Authorization" }
      ]
    }
  ]
}

