# ==============================================================================
# SentimentAI Frontend Environment Configuration
# ==============================================================================

# Option A (Recommended for Vercel production deployment):
# Proxied via Vercel rewrite in frontend/vercel.json -> transparently routes to Render backend
# No browser CORS overhead, eliminates 405 Method Not Allowed errors
VITE_API_URL=/api
VITE_BACKEND_URL=https://sentix-backend.onrender.com

# Option B (Direct cross-origin requests to live Render backend):
# VITE_API_URL=https://sentix-backend.onrender.com/api
