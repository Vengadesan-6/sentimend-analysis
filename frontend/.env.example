# ==============================================================================
# SentimentAI Frontend Environment Configuration
# ==============================================================================

# For local development with Vite dev server proxy:
# Leave blank or set to '/api'. Requests to '/api/...' will be proxied to http://127.0.0.1:8000
VITE_API_URL=/api

# For production deployments with a live backend (e.g. Render, Railway, Vercel, AWS):
# Set this to your deployed backend URL (with or without /api):
# VITE_API_URL=https://sentiment-backend.onrender.com/api
